# Normalize line endings to LF in the repo; check out native on each OS.
# Prevents CRLF/LF churn between Windows dev machines and CI Linux runners.
* text=auto eol=lf

# Explicit text types
*.py    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.ini   text eol=lf

# Shell / batch scripts keep platform-native endings
*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Treat these as binary (no EOL normalization, no diff noise)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.whl   binary
